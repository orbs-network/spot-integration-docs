{
  "name": "spot-integration-docs",
  "version": "0.2.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "next dev --port 3004",
    "build": "yarn generate:integrations && next build",
    "start": "next start",
    "check:examples": "node --no-warnings --experimental-strip-types scripts/check-framework-neutral.mjs",
    "lint": "eslint && yarn check:examples && yarn check:integrations",
    "typecheck": "tsc --noEmit",
    "generate:integrations": "node --no-warnings --experimental-strip-types scripts/generate-integration-downloads.mjs",
    "check:integrations": "node --no-warnings --experimental-strip-types scripts/generate-integration-downloads.mjs --check && node scripts/check-integration-downloads.mjs && node --no-warnings --experimental-strip-types scripts/check-integration-behavior.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.555.0",
    "next": "^16.1.0",
    "nuqs": "^2.10.1",
    "prism-react-renderer": "^2.4.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.6",
    "typescript": "^5"
  }
}
